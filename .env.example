NODE_ENV=development
PORT=3000

# Local Docker Postgres (used when DB_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=foodexpress
DB_PASSWORD=foodexpress
DB_NAME=foodexpress

# Set this to connect to a cloud Postgres (Neon, Supabase, etc.) instead of
# the local Docker one — overrides DB_HOST/PORT/USERNAME/PASSWORD/NAME above.
# DB_URL=postgresql://user:password@host/dbname
# DB_SSL=true

JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed origins for the frontend, e.g.
# https://app.example.com,https://admin.example.com
# Left unset, CORS allows any origin — fine for local dev, not for production.
# CORS_ORIGIN=
